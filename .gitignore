__pycache__/
# crux-lab episodes: large work files are not committed (the master is recorded by SHA-256)
episodes/*/work/picture*.mp4
episodes/*/*/work/picture*.mp4
episodes/*/out/video.mp4
episodes/*/*/out/video.mp4
episodes/*/out/audio/master.wav
episodes/*/*/out/audio/master.wav
episodes/*/work/animatic/
episodes/*/work/*.wav
episodes/*/out/voice/final/
episodes/*/*/work/palettes/
episodes/*/work/replaced-takes/

# Third-party data that is not public domain (FRED / Freddie Mac PMMS, Optimal Blue):
# never commit raw or verbatim-normalized copies. Re-fetch with
# episodes/<ep>/data/fetch.py (SHA-256, URL and download date are in data/sources.json).
episodes/*/data/raw/
episodes/*/data/normalized/mortgage30_weekly.csv
episodes/*/data/normalized/crosscheck_weekly.csv
episodes/*/work/retired-takes/
episodes/*/*/render/data.js

# Tập 2: dữ liệu FRED chuẩn hoá (tải lại bằng episodes/ep002/data/fetch.py)
episodes/ep002/data/normalized/
episodes/ep002/out/checks/cache/
