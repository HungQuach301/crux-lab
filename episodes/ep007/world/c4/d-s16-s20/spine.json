   "mode": "world",
   "idea": "(lượt 2)",
   "visual": "(lượt 2: chưa dựng)",
   "line": "The reason is the gap: in the 2010s and 2020s it typically ran about 0.7 point, against about 0.45 in the 1990s and 2000s.",
   "sound": [],
   "music": 0.3,
   "emotion": "—",
   "next": "—",
   "t0": 28.26,
   "t1": 40.44,
   "cues": {}
  },
  {
