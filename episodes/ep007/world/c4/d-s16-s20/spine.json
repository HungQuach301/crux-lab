   "mode": "world",
   "idea": "(lượt 2)",
   "visual": "(lượt 2: chưa dựng)",
   "line": "In the 2010s, rates were far lower, yet the fallback cost more: $20,374.",
   "sound": [],
   "music": 0.3,
   "emotion": "—",
   "next": "—",
   "t0": 19.493,
