   "mode": "world",
   "idea": "(lượt 2)",
   "visual": "(lượt 2: chưa dựng)",
   "line": "In the 2000s, with lower rates, it cost about the same: $14,210.",
   "sound": [],
   "music": 0.3,
   "emotion": "—",
   "next": "—",
   "t0": 11.127,
   "t1": 18.427,
   "cues": {}
