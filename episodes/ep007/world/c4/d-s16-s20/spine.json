   "idea": "(lượt 2)",
   "visual": "(lượt 2: chưa dựng)",
   "line": "In the 1990s, the typical fallback cost $15,118.",
   "sound": [],
   "music": 0.3,
   "emotion": "—",
   "next": "—",
   "t0": 5.02,
   "t1": 10.08,
   "cues": {}
