 "sentences": [
  {
   "id": "S08.1",
   "scene": "S08",
   "text": "First, why is the line flat?",
   "spoken": "First, why is the line flat?",
   "start": 0.0,
   "end": 1.841
  },
  {
   "id": "S08.2",
   "scene": "S08",
   "text": "The cap is written as a plain dollar amount, and it has never been adjusted.",
   "spoken": "The cap is written as a plain dollar amount, and it has never been adjusted.",
   "start": 2.021,
   "end": 6.321
  },
  {
   "id": "S08.3",
   "scene": "S08",
   "text": "If $500,000 from May 1997 had kept up with consumer prices, it would be about $1,046,000 in August 2026 dollars.",
   "spoken": "If five hundred thousand dollars from May nineteen ninety-seven had kept up with consumer prices, it would be about one million forty-six thousand dollars in August twenty twenty-six dollars.",
   "start": 6.534,
   "end": 17.761
  },
  {
   "id": "S08.4",
   "scene": "S08",
   "text": "It's everyday prices, not house prices, but it shows why a cap that never moves covers less and less of a long-held home's gain.",
   "spoken": "It's everyday prices, not house prices, but it shows why a cap that never moves covers less and less of a long-held home's gain.",
   "start": 17.788,
   "end": 26.881
  },
  {
   "id": "S13.1",
   "scene": "S13",
   "text": "In Phoenix, for a home that rose like the average, that price is about $179,200.",
   "spoken": "In Phoenix, for a home that rose like the average, that price is about one hundred seventy-nine thousand two hundred dollars.",
   "start": 28.067,
   "end": 35.507
  },
  {
   "id": "S13.2",
   "scene": "S13",
   "text": "Rosa and Frank paid more than that, and that's why their line crossed.",
   "spoken": "Rosa and Frank paid more than that, and that's why their line crossed.",
   "start": 35.571,
   "end": 39.587
  },
  {
   "id": "S13.3",
   "scene": "S13",
   "text": "Below that price, a Phoenix home is still under the cap; above it, it's over.",
   "spoken": "Below that price, a Phoenix home is still under the cap; above it, it's over.",
   "start": 39.707,
   "end": 44.067
  },
  {
   "id": "S14.1",
   "scene": "S14",
   "text": "Do that for all 12 metro areas, each for a home that rose like its metro area's average, and you get a ladder of prices.",
   "spoken": "Do that for all twelve metro areas, each for a home that rose like its metro area's average, and you get a ladder of prices.",
   "start": 45.267,
   "end": 52.867
  },
  {
   "id": "S14.2",
   "scene": "S14",
   "text": "Miami sits at the bottom of the ladder, and Chicago at the top.",
   "spoken": "Miami sits at the bottom of the ladder, and Chicago at the top.",
   "start": 53.027,
   "end": 57.027
  },
  {
   "id": "S14.3",
   "scene": "S14",
   "text": "The faster an area's prices rose, the lower its rung: Miami's rose the most, Chicago's the least.",
   "spoken": "The faster an area's prices rose, the lower its rung: Miami's rose the most, Chicago's the least.",
   "start": 57.227,
   "end": 65.107
  },
  {
   "id": "S14.4",
   "scene": "S14",
   "text": "Every city except Chicago sits under $300,000.",
   "spoken": "Every city except Chicago sits under three hundred thousand dollars.",
   "start": 65.254,
   "end": 69.667
  },
  {
   "id": "S14.5",
   "scene": "S14",
   "text": "That's the cap, read a third way: not as a flat line, but as a 2000 price anyone can look up.",
   "spoken": "That's the cap, read a third way: not as a flat line, but as a two thousand price anyone can look up.",
   "start": 69.779,
   "end": 77.187
  }
 ],
