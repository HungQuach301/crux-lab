 "sentences": [
  {
   "id": "S04.1",
   "scene": "S04",
   "text": "We took the actual 3-month bill rate for every month since 1934 and started a 20-year roll in each month from January 1934 to September 2006, the last start whose 20 years are complete.",
   "spoken": "We took the actual three-month bill rate for every month since nineteen thirty-four and started a twenty-year roll in each month from January nineteen thirty-four to September two thousand six, the last start whose twenty years are complete.",
   "start": 0.0,
   "end": 16.96
  },
  {
   "id": "S04.2",
   "scene": "S04",
   "text": "Each time a bill comes due, the money, interest and all, goes into the next bill at that month's rate.",
   "spoken": "Each time a bill comes due, the money, interest and all, goes into the next bill at that month's rate.",
   "start": 17.248,
   "end": 24.64
  },
  {
   "id": "S04.3",
   "scene": "S04",
   "text": "Each start is a saver like Dana putting money in and leaving it alone, and the results swing hard.",
   "spoken": "Each start is a saver like Dana putting money in and leaving it alone, and the results swing hard.",
   "start": 24.848,
   "end": 33.32
  },
  {
   "id": "S04.4",
   "scene": "S04",
   "text": "A saver who started in May 1972 ended with 4.612 times the money; one who started in January 1934 ended with just 1.129 times.",
   "spoken": "A saver who started in May nineteen seventy-two ended with four point six one two times the money; one who started in January nineteen thirty-four ended with just one point one two nine times.",
   "start": 33.54,
   "end": 49.68
  },
  {
   "id": "S04.5",
   "scene": "S04",
   "text": "Across all the start months there are 873 of these rolls.",
   "spoken": "Across all the start months there are eight hundred seventy-three of these rolls.",
   "start": 49.84,
   "end": 55.76
  },
  {
   "id": "S04.6",
   "scene": "S04",
   "text": "They overlap a lot, so together they amount to a few long stretches of history, not 873 separate tries.",
   "spoken": "They overlap a lot, so together they amount to a few long stretches of history, not eight hundred seventy-three separate tries.",
   "start": 55.856,
   "end": 64.56
  },
  {
   "id": "S04.7",
   "scene": "S04",
   "text": "For each one there's a single question: did the roll end above double? US only, and history, not a forecast.",
   "spoken": "For each one there's a single question: did the roll end above double? U.S. only, and history, not a forecast.",
   "start": 64.68,
   "end": 73.76
  }
 ],
