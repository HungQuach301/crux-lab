   "sequence": 4,
   "scene": "S18",
   "start_s": 500.065,
   "end_s": 501.565,
   "text": "It depends on the size of the loan."
  },
  {
   "type": "pause",
   "kind": "same",
   "start_s": 501.565,
   "end_s": 502.285,
   "dur_s": 0.72,
   "before_n": 91
  },
  {
   "type": "sentence",
   "n": 91,
   "sequence": 4,
   "scene": "S18",
   "start_s": 502.285,
   "end_s": 507.105,
   "text": "For Walt, with a loan of $115,000, it takes more than a full point."
  },
  {
   "type": "pause",
   "kind": "same",
   "start_s": 507.105,
   "end_s": 507.855,
   "dur_s": 0.75,
   "before_n": 92
  },
  {
   "type": "sentence",
   "n": 92,
   "sequence": 4,
   "scene": "S18",
   "start_s": 507.855,
   "end_s": 511.775,
   "text": "For Nora, with $375,000, half a point."
  },
  {
   "type": "pause",
   "kind": "same",
   "start_s": 511.775,
   "end_s": 512.545,
   "dur_s": 0.77,
   "before_n": 93
  },
  {
   "type": "sentence",
   "n": 93,
   "sequence": 4,
   "scene": "S18",
   "start_s": 512.545,
   "end_s": 516.985,
   "text": "For Anjali, with $655,000, about a third of a point."
